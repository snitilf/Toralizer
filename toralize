#!/bin/bash
#
# toralize - run a program with toralize.dylib injected, so its IPv4 TCP
# connect() calls go through tor's SOCKS4 proxy on 127.0.0.1:9050
#
# the program must not be SIP-protected: macOS strips DYLD_INSERT_LIBRARIES
# for system binaries such as /usr/bin/curl, so use homebrew or self-built ones
#
# usage: ./toralize <program> [args...]
# example: ./toralize "$(brew --prefix curl)/bin/curl" -4 -s https://check.torproject.org/api/ip

# get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# path to the toralize.dylib library
LIB_PATH="${SCRIPT_DIR}/toralize.dylib"

# check if the library exists
if [ ! -f "$LIB_PATH" ]; then
    echo "error: toralize.dylib not found"
    echo "please run 'make' first to build the library"
    exit 1
fi

# check if a program was provided
if [ $# -eq 0 ]; then
    echo "usage: $0 <program> [args...]"
    echo ""
    echo "example (SIP-protected binaries such as /usr/bin/curl are not affected):"
    echo "  $0 \"\$(brew --prefix curl)/bin/curl\" -4 -s https://check.torproject.org/api/ip"
    exit 1
fi

# export the DYLD_INSERT_LIBRARIES environment variable
# this tells dyld to load our library into the program
export DYLD_INSERT_LIBRARIES="$LIB_PATH"

# execute the program with all its arguments
exec "$@"

