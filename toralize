#!/bin/bash
# usage: toralize <program> [args...]
# runs <program> with toralize.dylib injected, so its IPv4 TCP connect() calls go through tor
set -eu

if [ $# -eq 0 ]; then
    echo "usage: toralize <program> [args...]" >&2
    exit 2
fi

lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/toralize.dylib"
if [ ! -f "$lib" ]; then
    echo "toralize: $lib not found, run make first" >&2
    exit 1
fi

# macOS strips DYLD_INSERT_LIBRARIES for SIP-protected programs, so warn and still run it
prog=$(command -v -- "$1" || true)
if [ -n "$prog" ]; then
    case "$prog" in
        /usr/bin/*|/bin/*|/sbin/*|/usr/sbin/*|/System/*) protected=1 ;;
        *) protected=0 ;;
    esac
    if [ "$protected" = 0 ] && ls -lOL "$prog" 2>/dev/null | grep -qw restricted; then
        protected=1
    fi
    if [ "$protected" = 1 ]; then
        echo "[toralize] warning: $prog is protected by SIP, DYLD_INSERT_LIBRARIES is stripped and the connection will not be rerouted" >&2
    fi
fi

export DYLD_INSERT_LIBRARIES="$lib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
exec "$@"
