#!/bin/bash
# usage: toralize <program> [args...]
# runs <program> with toralize.dylib injected, so its IPv4 TCP connect() calls go through tor
set -eu

if [ $# -eq 0 ]; then
    echo "usage: toralize <program> [args...]" >&2
    exit 2
fi

lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/toralize.dylib"
if [ ! -f "$lib" ]; then
    echo "toralize: $lib not found, run make first" >&2
    exit 1
fi

export DYLD_INSERT_LIBRARIES="$lib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
exec "$@"
